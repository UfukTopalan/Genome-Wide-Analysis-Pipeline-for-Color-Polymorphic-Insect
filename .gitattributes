# Route large / data files through Git LFS instead of normal git storage.
# This keeps the repo fast to clone and avoids GitHub's 100MB hard file-size limit.

*.fasta filter=lfs diff=lfs merge=lfs -text
*.fa filter=lfs diff=lfs merge=lfs -text
*.sites filter=lfs diff=lfs merge=lfs -text
data/genotypes/*.tsv filter=lfs diff=lfs merge=lfs -text
